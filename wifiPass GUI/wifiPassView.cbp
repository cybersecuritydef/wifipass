<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="wifiPass GUI" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/wifiPass GUI" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add directory="C:/wxwidgets/lib/gcc_dll/mswu" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="C:/wxwidgets/lib/gcc_dll/mswu" />
				</ResourceCompiler>
				<Linker>
					<Add option="-lwlanapi" />
					<Add library="libwxmsw30u.a" />
					<Add directory="C:/wxwidgets/lib/gcc_dll" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/wifiPass GUI" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="C:/wxwidgets/lib/gcc_dll/mswu" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="C:/wxwidgets/lib/gcc_dll/mswu" />
				</ResourceCompiler>
				<Linker>
					<Add option="-s" />
					<Add option="-lwlanapi" />
					<Add library="libwxmsw30u.a" />
					<Add directory="C:/wxwidgets/lib/gcc_dll" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-pipe" />
			<Add option="-mthreads" />
			<Add option="-D__GNUWIN32__" />
			<Add option="-D__WXMSW__" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DwxUSE_UNICODE" />
			<Add option="-Wall" />
			<Add directory="C:/wxwidgets/include" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="C:/wxwidgets/include" />
		</ResourceCompiler>
		<Linker>
			<Add option="-mthreads" />
		</Linker>
		<Unit filename="app.cpp" />
		<Unit filename="app.h" />
		<Unit filename="main.cpp" />
		<Unit filename="main.h" />
		<Unit filename="passview.cpp" />
		<Unit filename="passview.h" />
		<Unit filename="resource.rc">
			<Option compilerVar="WINDRES" />
		</Unit>
		<Unit filename="topmenu.cpp" />
		<Unit filename="topmenu.h" />
		<Unit filename="wifi.h" />
		<Unit filename="wiifi.cpp" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
